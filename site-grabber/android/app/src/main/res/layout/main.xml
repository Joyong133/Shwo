<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="https://example.com/blog/" android:inputType="textUri" android:singleLine="true"
        android:imeOptions="actionGo" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="최대 페이지" />
        <EditText android:id="@+id/max" android:layout_width="80dp" android:layout_height="wrap_content"
            android:inputType="number" android:text="300" android:gravity="center" />
        <CheckBox android:id="@+id/whole" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="사이트 전체" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <CheckBox android:id="@+id/images" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="이미지·첨부파일" android:checked="true" />
        <CheckBox android:id="@+id/js" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JS 사이트 모드" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="가져오기" android:backgroundTint="@color/accent" android:textColor="#FFFFFF" />
        <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="멈추기" android:enabled="false" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="8dp"
        android:text="주소를 넣고 '가져오기'를 누르세요. 다른 앱에서 링크를 '공유'해도 됩니다." />

    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/saveZip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="전부 저장 (ZIP)" android:enabled="false" />
        <Button android:id="@+id/saveTxt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="텍스트만 저장" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
